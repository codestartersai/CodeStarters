# ==============================================================================
# CodeStarters Environment Configuration
# Copy this file to .env or .env.local and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
# Project URL (public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Anon Public Key (browser client)
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_ANON_KEY="eyJhbGciOi..."

# Service Role Secret Key (REQUIRED for server-side admin management, RLS bypass & user provisioning)
# WARNING: NEVER expose this key in public client-side code!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 2. Gmail SMTP Connector (Google App Password)
# ------------------------------------------------------------------------------
# The Google email address used to send single-use admin invites and client responses
GMAIL_USER="codestartersai@gmail.com"

# 16-character Google App Password generated from myaccount.google.com/apppasswords
# (Do NOT use your primary Google login password. 2-Step Verification must be ON)
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
